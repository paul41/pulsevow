{
  "name": "pulsevow-backend",
  "version": "1.0.0",
  "description": "Backend API for PulseVow, an AI-first news intelligence platform built with Node.js, Express, TypeScript, PostgreSQL, and Redis. Provides authentication, news aggregation, AI-powered summaries, sentiment analysis, impact scoring, semantic search, recommendations, and community services.",
  "license": "MIT",
  "author": "PaulS",
  "type": "module",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
    "build": "cross-env NODE_ENV=production tsc",
    "start:prod": "cross-env NODE_ENV=production node dist/server.js",
    "staging": "cross-env NODE_ENV=staging node dist/server.js",
    "test": "cross-env NODE_ENV=test jest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "app:scheduler": "tsx src/workers/scheduler.ts",
    "worker:embedding": "tsx src/workers/embedding.worker.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "^0.45.1",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.0.8",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.10.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "openai": "^7.13.0",
    "p-limit": "^7.3.1",
    "prisma": "6.19.3",
    "rss-parser": "^3.13.0",
    "slugify": "^1.6.9",
    "zod": "^4.4.3"
  }
}
