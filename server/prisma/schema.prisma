generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  passwordHash    String
  avatar          String?
  role            UserRole         @default(USER)
  isEmailVerified Boolean          @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  language        String           @default("English")
  bookmarks       Bookmark[]
  comments        Comment[]
  likes           Like[]
  notifications   Notification[]
  readingHistory  ReadingHistory[]
  refreshTokens   RefreshToken[]
  searchHistory   SearchHistory[]
  interests       UserInterest[]

  @@index([email])
}

model UserInterest {
  userId     String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([categoryId])
}

model Source {
  id         String       @id @default(uuid())
  name       String       @unique
  logo       String?
  country    String?
  language   String?
  trustScore Int          @default(50)
  type       SourceType
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  siteUrl    String       @unique
  articles   Article[]
  feeds      SourceFeed[]

  @@index([isActive])
}

model SourceFeed {
  id            String    @id @default(uuid())
  sourceId      String
  url           String    @unique
  isActive      Boolean   @default(true)
  lastFetchedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  source        Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([isActive])
}

model Category {
  id           String         @id @default(uuid())
  name         String
  slug         String         @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  articles     Article[]
  UserInterest UserInterest[]

  @@index([name])
}

model NewsStory {
  id              String          @id @default(uuid())
  title           String
  slug            String          @unique
  description     String?
  status          ArticleStatus   @default(DRAFT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  articles        Article[]
  industryImpacts StoryIndustry[]
  timelineEvents  TimelineEvent[]
  trend           Trend?

  @@index([status, createdAt])
  @@index([createdAt])
}

model Article {
  id             String            @id @default(uuid())
  sourceId       String
  categoryId     String
  title          String
  slug           String            @unique
  description    String?
  url            String            @unique
  imageUrl       String?
  author         String?
  publishedAt    DateTime
  status         ArticleStatus     @default(DRAFT)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  contentHash    String?           @unique
  storyId        String?
  category       Category          @relation(fields: [categoryId], references: [id])
  source         Source            @relation(fields: [sourceId], references: [id])
  story          NewsStory?        @relation(fields: [storyId], references: [id])
  analysis       ArticleAnalysis?
  embedding      ArticleEmbedding?
  tags           ArticleTag[]
  bookmarks      Bookmark[]
  comments       Comment[]
  likes          Like[]
  readingHistory ReadingHistory[]
  searchHistory  SearchHistory[]

  @@index([storyId])
  @@index([sourceId])
  @@index([categoryId])
  @@index([status, publishedAt])
  @@index([contentHash])
}

model ArticleEmbedding {
  id        String                @id @default(uuid())
  articleId String                @unique
  model     String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  embedding Unsupported("vector")
  article   Article               @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model Tag {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  type      TagType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  articles  ArticleTag[]

  @@index([type])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model Industry {
  id           String          @id @default(uuid())
  name         String
  slug         String          @unique
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  storyImpacts StoryIndustry[]

  @@index([name])
}

model StoryIndustry {
  storyId     String
  industryId  String
  impactScore Float
  confidence  Float?
  reason      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  industry    Industry  @relation(fields: [industryId], references: [id], onDelete: Cascade)
  story       NewsStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([storyId, industryId])
  @@index([industryId])
  @@index([impactScore])
}

model ArticleAnalysis {
  id                  String     @id @default(uuid())
  articleId           String     @unique
  summary             String?
  sentiment           Sentiment?
  impactScore         Float?
  credibilityScore    Float?
  biasScore           Float?
  confidence          Float?
  generatedAt         DateTime   @default(now())
  neutralityScore     Float?
  sensationalismScore Float?
  updatedAt           DateTime   @updatedAt
  article             Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model TimelineEvent {
  id          String    @id @default(uuid())
  title       String
  description String?
  eventDate   DateTime
  sequence    Int
  createdAt   DateTime  @default(now())
  storyId     String
  updatedAt   DateTime  @updatedAt
  story       NewsStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, sequence])
  @@index([storyId])
  @@index([storyId, eventDate])
}

model Trend {
  id             String    @id @default(uuid())
  score          Float
  mentions       Int       @default(0)
  searchVolume   Int       @default(0)
  socialMentions Int       @default(0)
  updatedAt      DateTime  @updatedAt
  storyId        String    @unique
  story          NewsStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
}

model ReadingHistory {
  id        String   @id @default(uuid())
  userId    String
  articleId String
  timeSpent Int?
  completed Boolean  @default(false)
  readAt    DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
}

model SearchHistory {
  id               String   @id @default(uuid())
  userId           String
  query            String
  clickedArticleId String?
  searchedAt       DateTime @default(now())
  clickedArticle   Article? @relation(fields: [clickedArticleId], references: [id])
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([query])
  @@index([clickedArticleId])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
}

model Comment {
  id        String    @id @default(uuid())
  content   String
  userId    String
  articleId String
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     Like[]

  @@index([articleId])
  @@index([userId])
  @@index([parentId])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  articleId String?
  commentId String?
  createdAt DateTime @default(now())
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@unique([userId, commentId])
  @@index([userId])
  @@index([articleId])
  @@index([commentId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SourceType {
  RSS
  API
  SCRAPER
}

enum TagType {
  PERSON
  COMPANY
  ORGANIZATION
  COUNTRY
  CITY
  STATE
  POLITICIAN
  TECHNOLOGY
  PRODUCT
  TOPIC
  EVENT
  CURRENCY
  STOCK
}

enum Sentiment {
  POSITIVE
  NEGATIVE
  NEUTRAL
  MIXED
}
