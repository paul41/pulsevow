generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// USER
// ======================================================

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  passwordHash    String
  avatar          String?
  role            UserRole  @default(USER)
  isEmailVerified Boolean   @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens  RefreshToken[]
  bookmarks      Bookmark[]
  comments       Comment[]
  likes          Like[]
  notifications  Notification[]
  readingHistory ReadingHistory[]
  searchHistory  SearchHistory[]

  @@index([email])
}

// ======================================================
// SOURCE
// ======================================================

model Source {
  id         String     @id @default(uuid())
  name       String     @unique
  siteUrl    String     @unique
  logo       String?
  country    String?
  language   String?
  trustScore Int        @default(50)
  type       SourceType
  isActive   Boolean    @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  feeds    SourceFeed[]
  articles Article[]

  @@index([isActive])
}

// ======================================================
// SOURCE FEEDS
// ======================================================

model SourceFeed {
  id            String    @id @default(uuid())
  sourceId      String
  url           String    @unique
  isActive      Boolean   @default(true)
  lastFetchedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([isActive])
}

// ======================================================
// CATEGORY
// ======================================================

model Category {
  id   String @id @default(uuid())
  name String
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles Article[]

  @@index([name])
}

// ======================================================
// NEWS STORY
// Central entity for multi-source aggregation
// ======================================================

model NewsStory {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  description String?
  status      ArticleStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles        Article[]
  industryImpacts StoryIndustry[]
  timelineEvents  TimelineEvent[]
  trend           Trend?

  @@index([status, createdAt])
  @@index([createdAt])
}

// ======================================================
// ARTICLE
// Individual publisher article belonging to a NewsStory
// ======================================================

model Article {
  id         String @id @default(uuid())
  storyId    String?
  sourceId   String
  categoryId String

  title       String
  slug        String   @unique
  description String?
  url         String   @unique
  imageUrl    String?
  author      String?
  publishedAt DateTime

  status ArticleStatus @default(DRAFT)

  contentHash String? @unique
  embedding ArticleEmbedding?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  story    NewsStory? @relation(fields: [storyId], references: [id], onDelete: SetNull)
  source   Source     @relation(fields: [sourceId], references: [id])
  category Category   @relation(fields: [categoryId], references: [id])

  analysis       ArticleAnalysis?
  tags           ArticleTag[]
  bookmarks      Bookmark[]
  comments       Comment[]
  likes          Like[]
  readingHistory ReadingHistory[]
  searchHistory  SearchHistory[]

  @@index([storyId])
  @@index([sourceId])
  @@index([categoryId])
  @@index([status, publishedAt])
  @@index([contentHash])
}

model ArticleEmbedding {
  id        String   @id @default(uuid())
  articleId String   @unique
  model     String
  embedding Unsupported("vector(1536)")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

// ======================================================
// TAG
// Topics/entities extracted from articles
// ======================================================

model Tag {
  id   String  @id @default(uuid())
  name String
  slug String  @unique
  type TagType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles ArticleTag[]

  @@index([type])
}

// ======================================================
// ARTICLE ↔ TAG
// ======================================================

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

// ======================================================
// INDUSTRY
// ======================================================

model Industry {
  id   String @id @default(uuid())
  name String
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  storyImpacts StoryIndustry[]

  @@index([name])
}

// ======================================================
// NEWS STORY ↔ INDUSTRY
// ======================================================

model StoryIndustry {
  storyId    String
  industryId String

  impactScore Float
  confidence  Float?
  reason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  story    NewsStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  industry Industry  @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@id([storyId, industryId])
  @@index([industryId])
  @@index([impactScore])
}

// ======================================================
// ARTICLE ANALYSIS
// ======================================================

model ArticleAnalysis {
  id        String @id @default(uuid())
  articleId String @unique

  summary             String?
  sentiment           Sentiment?
  impactScore         Float?
  credibilityScore    Float?
  biasScore           Float?
  confidence          Float?
  sensationalismScore Float?
  neutralityScore     Float?

  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

// ======================================================
// TIMELINE
// Timeline belongs to NewsStory
// ======================================================

model TimelineEvent {
  id          String   @id @default(uuid())
  storyId     String
  title       String
  description String?
  eventDate   DateTime
  sequence    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  story NewsStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, sequence])
  @@index([storyId])
  @@index([storyId, eventDate])
}

// ======================================================
// TREND
// Trend belongs to NewsStory
// ======================================================

model Trend {
  id      String @id @default(uuid())
  storyId String @unique

  score          Float
  mentions       Int   @default(0)
  searchVolume   Int   @default(0)
  socialMentions Int   @default(0)

  updatedAt DateTime @updatedAt

  story NewsStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
}

// ======================================================
// READING HISTORY
// ======================================================

model ReadingHistory {
  id        String @id @default(uuid())
  userId    String
  articleId String

  timeSpent Int?
  completed Boolean  @default(false)
  readAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
}

// ======================================================
// SEARCH HISTORY
// ======================================================

model SearchHistory {
  id               String   @id @default(uuid())
  userId           String
  query            String
  clickedArticleId String?
  searchedAt       DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clickedArticle Article? @relation(fields: [clickedArticleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([query])
  @@index([clickedArticleId])
}

// ======================================================
// BOOKMARK
// ======================================================

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
}

// ======================================================
// COMMENT
// ======================================================

model Comment {
  id        String  @id @default(uuid())
  content   String
  userId    String
  articleId String
  parentId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  likes Like[]

  @@index([articleId])
  @@index([userId])
  @@index([parentId])
}

// ======================================================
// LIKE
// ======================================================

model Like {
  id String @id @default(uuid())

  userId    String
  articleId String?
  commentId String?

  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@unique([userId, commentId])
  @@index([userId])
  @@index([articleId])
  @@index([commentId])
}

// ======================================================
// NOTIFICATION
// ======================================================

model Notification {
  id      String  @id @default(uuid())
  userId  String
  title   String
  message String
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// ======================================================
// REFRESH TOKEN
// ======================================================

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ======================================================
// ENUMS
// ======================================================

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SourceType {
  RSS
  API
  SCRAPER
}

enum TagType {
  PERSON
  COMPANY
  ORGANIZATION
  COUNTRY
  CITY
  STATE
  POLITICIAN
  TECHNOLOGY
  PRODUCT
  TOPIC
  EVENT
  CURRENCY
  STOCK
}

enum Sentiment {
  POSITIVE
  NEGATIVE
  NEUTRAL
  MIXED
}
